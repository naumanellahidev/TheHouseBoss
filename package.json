{
  "name": "the-house-boss",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:rls": "tsx --env-file=.env.local scripts/test-rls.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:pending": "node scripts/check-pending.mjs",
    "db:types": "node --env-file=.env.local scripts/gen-types.mjs",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "gen:icons": "node scripts/generate-icons.mjs",
    "guards": "npm run check:tokens && npm run check:contrast && npm run check:migrations && npm run typecheck && npm run lint",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "db:verify": "node --env-file=.env.local scripts/db-verify.mjs",
    "db:probe": "node --env-file=.env.local scripts/db-probe.mjs",
    "verify:p2": "tsx --env-file=.env.local scripts/verify-phase2.mts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run guards && npm run build && npm run check:bundle && npm run check:pending",
    "seed:cities": "node --env-file=.env.local scripts/seed-city-content.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:compliance": "node scripts/check-compliance.mjs",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "check:lighthouse": "node scripts/lighthouse.mjs",
    "seed:images": "tsx --env-file=.env.local scripts/seed-images.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.37.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "lighthouse": "^13.4.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
