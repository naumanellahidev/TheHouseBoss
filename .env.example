# ─────────────────────────────────────────────────────────────────────────────
# THE HOUSE BOSS — environment
# Copy to .env.local and fill in. .env.local is git-ignored and must stay so.
# Reference: docs/12-env-deployment.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never log. Never import outside
# lib/supabase/service.ts — CLAUDE.md hard rule 20.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres password. Used ONLY by the scripts/db-*.mjs tooling, which
# connects through the IPv4 session pooler. Never referenced by the app.
#   node --env-file=.env.local scripts/db-migrate.mjs
SUPABASE_DB_PASSWORD=
# Optional: derived from NEXT_PUBLIC_SUPABASE_URL when not set.
SUPABASE_PROJECT_REF=

# ── Media (Phase 2) ──────────────────────────────────────────────────────────
# supabase | r2 | local
STORAGE_DRIVER=supabase
# e.g. https://xxxx.supabase.co/storage/v1/object/public/media
NEXT_PUBLIC_MEDIA_URL=

# ── Email (Phase 2) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
EMAIL_FROM="The House Boss <hello@thehousebossfl.com>"

# ── Secrets (Phase 2) ────────────────────────────────────────────────────────
# generate with: openssl rand -hex 32
CRON_SECRET=
DRAFT_PREVIEW_SECRET=

# ── Testing (Phase 2) ────────────────────────────────────────────────────────
# The admin account the Playwright admin suite signs in as. Create it once with
#   npm run admin:create -- someone@example.com
# The suite skips itself when this is unset.
ADMIN_TEST_EMAIL=

# ── AI SEO generation ────────────────────────────────────────────────────────
# Optional. Descriptions and titles are generated deterministically without
# these; the model only improves the prose. Publishing NEVER depends on them —
# if the endpoint is unreachable the deterministic generator is used and the
# record still publishes.
#
# Written against an OpenAI-compatible /chat/completions endpoint, which is what
# Ollama, Ollama Cloud and most hosted providers expose.
#
# NOTE: if OLLAMA_BASE_URL points at a machine on your own network it will not
# be reachable from Vercel — generation would work locally and silently fall
# back in production.
#   OLLAMA_BASE_URL=https://ollama.com/v1     (Ollama Cloud)
#   OLLAMA_MODEL=gemma4:31b
#
# Use a NON-REASONING instruct model. A reasoning model spends its whole token
# budget thinking and returns empty content for a task this small — measured:
# gpt-oss:20b and nemotron-3-nano both returned 0 characters at 900 tokens,
# while gemma4:31b answered in 1.5s. See lib/seo/auto/ollama.ts.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
