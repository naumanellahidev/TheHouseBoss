# ─────────────────────────────────────────────────────────────────────────────
# THE HOUSE BOSS — environment
# Copy to .env.local and fill in. .env.local is git-ignored and must stay so.
# Reference: docs/12-env-deployment.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never log. Never import outside
# lib/supabase/service.ts — CLAUDE.md hard rule 20.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres password. Used ONLY by the scripts/db-*.mjs tooling, which
# connects through the IPv4 session pooler. Never referenced by the app.
#   node --env-file=.env.local scripts/db-migrate.mjs
SUPABASE_DB_PASSWORD=
# Optional: derived from NEXT_PUBLIC_SUPABASE_URL when not set.
SUPABASE_PROJECT_REF=

# ── Media (Phase 2) ──────────────────────────────────────────────────────────
# supabase | r2 | local
STORAGE_DRIVER=supabase
# e.g. https://xxxx.supabase.co/storage/v1/object/public/media
NEXT_PUBLIC_MEDIA_URL=

# ── Email (Phase 2) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
EMAIL_FROM="The House Boss <hello@thehousebossfl.com>"

# ── Secrets (Phase 2) ────────────────────────────────────────────────────────
# generate with: openssl rand -hex 32
CRON_SECRET=
REVALIDATE_SECRET=
DRAFT_PREVIEW_SECRET=

# ── Testing (Phase 2) ────────────────────────────────────────────────────────
# The admin account the Playwright admin suite signs in as. Create it once with
#   npm run admin:create -- someone@example.com
# The suite skips itself when this is unset.
ADMIN_TEST_EMAIL=

# ── Future: Cloudflare R2 (docs/07 § 10) ─────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.thehousebossfl.com

# ── Future: Stellar MLS (docs/11-mls-future.md) ──────────────────────────────
# LISTING_SOURCE=manual
# STELLAR_API_URL=
# STELLAR_ACCESS_TOKEN=
# STELLAR_AGENT_MLS_ID=
